# Runtime state: the journal, the frozen evidence, the ledgers, sections, staging,
# logs, locks. Load-bearing but high-churn, and reconstructable from the journal —
# git does not track it.
state/
*.log

# Job prompts are runtime INPUT, not source, and the drop folder normally lives under
# PAPER_OUT_DIR rather than in the repo — so there is usually nothing here to ignore.
# This rule is insurance for a machine that redirects PAPER_INBOX_DIR back into the
# repo: prompts must never become tracked files, because the engine moves a finished
# one out of the folder and that shows up in git as a deletion.
/inbox/

# Delivered manuscripts, if OUT_DIR is pointed inside the repo.
/Manuscripts/

__pycache__/
*.pyc
.DS_Store
.claude/
.codex/

# live tutoring board (Tutor-Board) — scratch space, never tracked
live/
