# The deployed configuration: what the harness reads, where it writes, and what it is
# allowed to spend. Sourced by run.sh for every unit, so both units share one answer
# and a change is one edit here plus a restart.
#
# This is shell, sourced with `set -a`, so every assignment is exported. Keep it to
# plain KEY=value with no logic — a config file that can branch is a program.
#
# Everything here has a default in paperwriter/config.py; this file records the choices
# this machine actually runs with, and why they are the ones they are.

# --- Who writes, and who judges ----------------------------------------------
#
# Claude Opus, for every text call in the pipeline: gathering, grounding, planning, the
# argument map, outlining, drafting, review, ledger merges. On a logged-in seat rather
# than an API key, so it costs allowance rather than money.
#
# This used to be a two-tier split — a cheap model wrote, an expensive one judged —
# with a per-role override. Every one of those knobs was a second suspect for any
# quality problem, in a project whose entire product is prose quality. There is no
# volume argument that beats that, so there are no tiers.
PAPER_MODEL=claude-opus-5

# --- Where the evidence comes from -------------------------------------------
#
# Colon-separated, read-only. The gathering stage reads result files, tables and
# reference PDFs under these trees and freezes what it finds into state/evidence/.
# Nothing here is ever written to.
#
# THE FREEZE IS THE POINT. Once an evidence document is frozen it stops tracking the
# analysis, so a rerun mid-draft that shifts an AUC cannot silently change what the
# Methods section claims — half the manuscript would have been written against the old
# number and nothing would tell you which half. Re-freezing is a deliberate act: delete
# the corpus directory under state/evidence/ and the next cycle re-mines it.
#
# Example:
#   PAPER_SOURCE_DIRS=$HOME/TRD-EHR/results:$HOME/Research-Journey/paper1/references
PAPER_SOURCE_DIRS=

# --- Where finished papers go ------------------------------------------------
#
# The drop folder lives at <OUT_DIR>/_inbox and the manuscripts land beside it under
# <project>/<paper>/. Point this at a synced directory to commission a paper from a
# phone; a plain local path works identically and costs one directory listing less.
PAPER_OUT_DIR=

# --- Building ----------------------------------------------------------------
#
# The manuscript is authored in Markdown and converted with pandoc. The Markdown IS the
# deliverable, so a missing pandoc is not an error: the conversion is skipped, the
# manuscript is delivered anyway, and a log line says why. Set PAPER_BUILD_REQUIRED=1
# to invert that for a workflow where the .docx is the only artifact anyone opens.
PAPER_BUILD_FORMATS=docx
PAPER_BUILD_REQUIRED=0

# A reference .docx supplying the journal's styles. A job prompt may name its own in
# its Venue section, and that wins over this.
PAPER_REFERENCE_DOCX=

# --- Quiet hours -------------------------------------------------------------
#
# OFF, and this is the one setting that flips relative to the novel harness this grew
# out of.
#
# Quiet hours exist because the seat is shared with the person who owns the machine,
# and a fleet drafting through a Monday afternoon spends capacity that person needs.
# That reasoning holds for an overnight run measured in days. It does not hold here: a
# paper is an hour or two of work, and an author waiting on a Methods section does not
# want it deferred until five o'clock.
#
# Set to 1 to get the working day back. Nothing else changes, and a run in flight
# pauses at the next cycle and resumes when the window closes.
PAPER_QUIET_HOURS=0

# --- The editorial loop ------------------------------------------------------
#
# Three passes before the loop starts asking whether a section is still improving, six
# absolute. On measured trajectories the fourth pass rarely beat the third, and the
# tenth was routinely worse than the fifth.
PAPER_EDIT_MAX_PASSES=3
PAPER_EDIT_HARD_MAX_PASSES=6

# --- A pinned interpreter, if you want one -----------------------------------
#
# Nothing outside the standard library is imported, so the system python3 is enough and
# this is a convenience. Point it at a conda or venv interpreter to pin the version.
PAPER_PYTHON=
